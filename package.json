{
  "name": "hop-brawl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "art:build": "node scripts/build-art.mjs",
    "dev": "vite",
    "dev:server": "wrangler dev --local",
    "deploy": "npm run check && wrangler deploy",
    "build": "npm run typecheck && npm run build:client",
    "build:client": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@playwright/test": "1.64.0",
    "@types/howler": "2.2.13",
    "@types/node": "24.19.2",
    "@types/stats.js": "0.17.4",
    "@types/three": "0.186.0",
    "ffmpeg-static": "5.3.0",
    "lil-gui": "0.21.0",
    "stats.js": "0.17.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "gsap": "3.15.0",
    "howler": "2.2.4",
    "three": "0.186.1"
  }
}
